# ── OS / editor ────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/

# ── Secrets ────────────────────────────────────────────────────────────────────
# Sample files are committed; anything real is not.
.env
.env.*
!.env.sample
!.env.example
*.pem
*.key
!*.pub
.mcp.json
!.mcp.sample.json
.mcp-auth/

# ── Local agent working memory ─────────────────────────────────────────────────
# Both spellings, so a folder created under either name cannot leak.
.memory/
memory/
*.memory.md

# ── Generated by runs, never authored ──────────────────────────────────────────
# per-run artifacts: state, logs, prompts, raw agent output
agents/
# isolated worktrees
trees/
# run-local copies of records
runs/
# machine-generated task specs, one per run
specs/
*.db
*.db-wal
*.db-shm

# ── Dependencies / build output ────────────────────────────────────────────────
node_modules/
dist/
build/
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
coverage/
*.log
